{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "video_type": {
      "enum": [
        "product",
        "interpersonal",
        "explainer"
      ]
    },
    "duration": {
      "type": "object",
      "properties": {
        "min_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "min_seconds",
        "max_seconds"
      ],
      "additionalProperties": false
    },
    "scene_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "required_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "dual"
      ]
    },
    "facts_required": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "reference",
          "facts"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "topic",
    "audience",
    "goal",
    "video_type",
    "duration",
    "scene_count",
    "required_points",
    "language",
    "tone",
    "style",
    "aspect_ratio",
    "facts_required",
    "sources"
  ],
  "additionalProperties": false
}
