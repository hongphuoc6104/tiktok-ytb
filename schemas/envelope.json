{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "enum": [
        "content",
        "images",
        "audio",
        "render",
        "control"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_versions": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object"
    },
    "checks": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "passed",
        "errors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "module",
    "revision",
    "input_versions",
    "files",
    "payload",
    "checks"
  ],
  "additionalProperties": false
}
