          "name": {
            "type": "string",
            "minLength": 1
          },
          "appearance": {
            "type": "string",
            "minLength": 1
          },
          "outfit": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "appearance",
          "outfit"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scenes": {
