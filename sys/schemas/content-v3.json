                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "at": {
                        "type": "number",
                        "minimum": 0
                      },
                      "to": {
                        "type": "number"
                      },
                      "angle": {
                        "type": "number"
                      }
