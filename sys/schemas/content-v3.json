  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_hash": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "object",
      "properties": {
        "min_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "min_seconds",
        "max_seconds"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "required_points": {
